
* { font-family: "Microsoft YaHei UI", "Microsoft YaHei", "Segoe UI", sans-serif; font-size: 14px; color: #30322b; }
QMainWindow, QWidget#page, QStackedWidget, QScrollArea, QScrollArea > QWidget > QWidget { background: #f8f6ef; }
QLabel, QGroupBox, QCheckBox, QRadioButton { background: transparent; }
QWidget#rail { background: #ece9dd; border-right: 1px solid #d8d3c4; }
QLabel#brand { font-family: "Georgia", "SimSun", serif; font-size: 21px; font-weight: bold; color: #37382f; }
QLabel#brandNote, QLabel#small, QLabel#kicker { font-size: 12px; color: #67695b; }
QLabel#kicker { color: #8f4834; }
QLabel#heroTitle { font-family: "SimSun", "Songti SC", "Georgia", serif; font-size: 44px; font-weight: bold; color: #242720; }
QLabel#pageTitle { font-family: "SimSun", "Georgia", serif; font-size: 30px; font-weight: bold; }
QLabel#section { font-family: "SimSun", "Georgia", serif; font-size: 21px; font-weight: bold; }
QLabel#muted, QLabel#status { color: #65695b; }
QLabel#warning { color: #9a442d; }
QFrame#hero { background: #eee6d5; border: 1px solid #d9cdb5; border-radius: 12px; }
QFrame#card { background: #fcfaf4; border: 1px solid #d9d4c7; border-radius: 10px; }
QFrame#rule { background: #d4cebf; max-height: 1px; border: none; }
QPushButton, QToolButton { background: #fcfaf4; border: 1px solid #c6c0b0; padding: 7px 12px; border-radius: 6px; }
QPushButton:hover, QToolButton:hover { background: #eae5d7; border-color: #a69c87; }
QPushButton:pressed { background: #ded5c5; }
QPushButton:focus, QLineEdit:focus, QComboBox:focus, QTextEdit:focus, QPlainTextEdit:focus, QListWidget:focus { border: 1px solid #a65036; }
QPushButton:disabled { color: #958e82; background: #eeebe2; border-color: #d8d3c7; }
QPushButton#primary { color: #fff9ec; background: #984a32; border: 1px solid #984a32; font-weight: bold; padding: 8px 15px; }
QPushButton#primary:hover { background: #803d2b; }
QPushButton#nav { background: transparent; border: 1px solid transparent; padding: 10px 12px; text-align: left; font-size: 15px; }
QPushButton#nav:hover { background: #e5dfcf; }
QPushButton#nav:checked { background: #dfd7c5; border-color: #cfc4b2; color: #733c2b; font-weight: bold; }
QPushButton#nav:focus { border-color: #a65036; }
QPushButton#row { text-align: left; padding: 10px 12px; background: #f7f4eb; border-color: #dfdbce; }
QPushButton#row:hover { background: #ece6d6; border-color: #c5baa2; }
QLineEdit, QComboBox, QSpinBox, QTimeEdit, QDateEdit, QTextEdit, QPlainTextEdit, QTextBrowser, QListWidget, QTreeWidget {
    background: #fffdf8; border: 1px solid #ccc6b8; border-radius: 5px; padding: 6px; selection-background-color: #e0cbb8; selection-color: #33332c;
}
QComboBox, QSpinBox, QDateEdit, QTimeEdit { min-height: 20px; }
QListWidget::item, QTreeWidget::item { padding: 5px; }
QListWidget::item:selected, QTreeWidget::item:selected { background: #e5dbc8; color: #34332c; }
QScrollArea { border: none; }
QTabWidget::pane { background: #fcfaf4; border: 1px solid #d5cfc0; border-radius: 4px; }
QTabBar::tab { padding: 7px 12px; color: #595d50; background: #eae5d8; border-bottom: 2px solid transparent; }
QTabBar::tab:selected { background: #f9f6ed; border-bottom: 2px solid #a65036; color: #863e2e; }
QGroupBox { border: 1px solid #d7d0c1; border-radius: 7px; margin-top: 12px; padding: 12px 8px 6px; }
QGroupBox::title { subcontrol-origin: margin; left: 12px; color: #575d4f; }
QSplitter::handle { background: #ded8c9; }
QToolTip { color: #f8f5ec; background: #35382f; border: 1px solid #55594b; }
QScrollBar:vertical { background: transparent; width: 10px; }
QScrollBar::handle:vertical { background: #c9c2b1; min-height: 28px; border-radius: 4px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
